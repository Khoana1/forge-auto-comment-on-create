{
  "name": "forge-auto-comment-on-create",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "build": "node scripts/ci-forge-lint.js",
    "build:forge-cli": "forge lint"
  },
  "dependencies": {
    "@forge/api": "^7.2.0",
    "@forge/kvs": "^1.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@forge/cli": "^12.13.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/lib/validation.js"
    ]
  }
}
